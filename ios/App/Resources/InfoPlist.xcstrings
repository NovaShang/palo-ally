{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在同一个网络里时直接连你的主机，不绕道云端，更快。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connects straight to your host when you're on the same network, faster than going through the cloud."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音输入时需要用到麦克风，把你说的话变成文字。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone turns what you say into text."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用来把你说的话转成文字，发给助理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns what you say into text to send to your assistant."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫主机上的二维码把这台设备连上主机，或者拍照发给助理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the QR code on your host to connect this device, or take a photo to send to your assistant."
          }
        }
      }
    }
  },
  "version": "1.0"
}
