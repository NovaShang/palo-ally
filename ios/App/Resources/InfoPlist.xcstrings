{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音输入时需要用到麦克风，把你说的话变成文字。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone turns what you say into text."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用来把你说的话转成文字，发给助理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns what you say into text to send to your assistant."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫电脑上的二维码把这台设备连上电脑，或者拍照发给助理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the QR code on your computer to connect this device, or take a photo to send to your assistant."
          }
        }
      }
    }
  },
  "version": "1.0"
}
